{
  "name": "monomachia",
  "private": true,
  "version": "0.1.0",
  "description": "A one-on-one weapon duel in the browser: posture, parries, disarms and ultimates, built with three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build && node scripts/make-artifact.mjs",
    "preview": "vite preview --port 4173",
    "test": "npm run test:web && npm run test:godot",
    "test:web": "vitest run",
    "test:godot": "node scripts/godot.mjs test",
    "typecheck": "npm run typecheck:web && npm run typecheck:godot",
    "typecheck:web": "tsc --noEmit",
    "typecheck:godot": "node scripts/godot.mjs typecheck",
    "soak": "tsx scripts/soak.ts",
    "golden:record": "tsx scripts/golden/record.ts",
    "godot": "node scripts/godot.mjs",
    "godot:dev": "node scripts/godot.mjs dev",
    "godot:run": "node scripts/godot.mjs run",
    "shots": "node scripts/godot.mjs shots",
    "godot:fixtures": "tsx scripts/sim-fixtures.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
